# Copy this file to .env and set your own local values.
# .env is ignored by git; never commit a filled copy.
EXPO_PUBLIC_COURSE_BACKEND_URL=http://127.0.0.1:4310
# Backend-only secret. It deliberately has no EXPO_PUBLIC_ prefix because Expo
# embeds variables with that prefix in the client bundle. Use fictional values
# only in the course environment.
CAMPUSOPS_API_SECRET=
