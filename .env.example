# Copy this file to .env and set your own local values.
# .env is ignored by git; never commit a filled copy.
EXPO_PUBLIC_COURSE_BACKEND_URL=http://127.0.0.1:4310
# Secreto del backend. Sin el prefijo EXPO_PUBLIC_ a proposito: ese prefijo
# incrusta el valor en el paquete del cliente. Este valor nunca debe viajar
# en la aplicacion. Usa unicamente datos ficticios en clase.
CAMPUSOPS_API_SECRET=
